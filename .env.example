# ── Email OTP (REQUIRED for signup/login to work) ──────────────
# From https://resend.com → API Keys
RESEND_API_KEY=
# A sender verified in Resend, e.g. "GnC Verdict <noreply@gncsignal.com>"
SENDER_EMAIL=
# Random hex — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the fallback DEV_SECRET makes all OTPs predictable — do not ship.
OTP_SECRET=

# ── Supabase (optional — only needed for verdict history / user DB) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.gncsignal.com
